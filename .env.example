# ===========================================
# ROAM - Environment Variables
# ===========================================
#
# Copy this file to .env.local for local development.
# For production, add these to Vercel Environment Variables.

# ------------------------------------------
# SERVER-SIDE ONLY (Vercel Environment Variables)
# ------------------------------------------
# These are used by serverless functions in /api
# They stay secret and never reach the browser.

# Ticketmaster Discovery API
# Get free key: https://developer.ticketmaster.com/
# Free tier: 5,000 requests/day, 5 requests/second
TICKETMASTER_KEY=

# Eventbrite API Token
# Note: Public search API deprecated since 2023
# Requires Destination API access for full functionality
EVENTBRITE_TOKEN=

# Skiddle API (UK-focused: clubs, festivals, nightlife)
# Get free key: https://www.skiddle.com/api/join.php
SKIDDLE_KEY=

# ------------------------------------------
# STRIPE (Payments)
# ------------------------------------------
# Get keys from Stripe Dashboard > Developers > API keys
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Create products in Stripe Dashboard > Products
STRIPE_PRICE_PREMIUM_MONTHLY=price_xxx
STRIPE_PRICE_PREMIUM_ANNUAL=price_xxx

# ------------------------------------------
# CLIENT-SIDE (Optional - bundled into JS)
# ------------------------------------------
# VITE_ prefixed variables are exposed to the browser.
# Only use for non-sensitive configuration.

# OpenTripMap API Key (for enriched place data)
# Get free key: https://opentripmap.io/product
# VITE_OPENTRIPMAP_KEY=

# Stripe publishable key (safe for client-side)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_xxx

# Apple Sign-In client config (safe for client-side)
# VITE_APPLE_SIGNIN_SERVICES_ID is used by the web JS popup flow.
# VITE_APPLE_BUNDLE_ID and VITE_APPLE_REDIRECT_URI are used by native iOS.
VITE_APPLE_SIGNIN_SERVICES_ID=com.goroam.app.signin
VITE_APPLE_BUNDLE_ID=com.goroam.app
VITE_APPLE_REDIRECT_URI=https://www.go-roam.uk/api/auth/apple/callback

# ------------------------------------------
# ADVERTISING — FREE-TIER MONETIZATION
# ------------------------------------------
# Without these set, the app ships with Google's official TEST ad unit
# IDs which serve test ads only (zero revenue, safe to ship).
#
# Set these to the real IDs once you've created the AdMob/AdSense
# entries. App IDs (the ca-app-pub-…~… values) are hardcoded in
# ios/App/App/Info.plist and android/app/src/main/res/values/strings.xml
# because they're compile-time constants — replace those manually after
# creating the AdMob console entries.

# Google AdMob — mobile ad unit IDs (ca-app-pub-…/… format)
# Create at https://admob.google.com → Apps → Ad units
VITE_ADMOB_IOS_BANNER_ID=
VITE_ADMOB_IOS_INTERSTITIAL_ID=
VITE_ADMOB_ANDROID_BANNER_ID=
VITE_ADMOB_ANDROID_INTERSTITIAL_ID=

# Google AdSense — web banner
# Apply at https://www.google.com/adsense (1–4 week approval).
# Don't forget to update public/ads.txt with the real publisher ID.
VITE_ADSENSE_CLIENT_ID=
VITE_ADSENSE_SLOT_BANNER=

# Event/ticket affiliate networks — sign up for any/all you can get into.
# Without these set, ticket URLs pass through unwrapped (no commission).
VITE_AWIN_PUBLISHER_ID=
VITE_SKIDDLE_AFFILIATE_ID=
VITE_TICKETMASTER_IMPACT_ID=
